#!/usr/bin/env sh
#
# Lanzador de renta-co.
#
# Resuelve su propia ubicación, así que funciona desde cualquier directorio y
# sin importar dónde quedó instalado el plugin. Es lo que hace que los mismos
# comandos sirvan clonando el repo y con el plugin instalado.
#
#   bin/renta calcular  --expediente ./expediente
#   bin/renta importar  --expediente ./expediente
#   bin/renta verificar --expediente ./expediente
#   bin/renta privacidad ./expediente/04-entregables
#
# Requiere Python 3.11 o superior (tomllib es stdlib desde ahí). Se busca
# explícitamente python3: en muchas máquinas `python` es un shim que apunta a
# una versión vieja.

set -e

RAIZ=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

PY=${RENTA_CO_PYTHON:-python3}

if ! command -v "$PY" >/dev/null 2>&1; then
    echo "✗ No se encontró '$PY'." >&2
    echo "  Instala Python 3.11+ o exporta RENTA_CO_PYTHON con la ruta correcta." >&2
    exit 1
fi

# Se compara contra un token propio: verificar solo que el comando "produjo
# salida" dejaba pasar cosas como /bin/echo, que imprime sus argumentos y
# hacía que el lanzador terminara en 0 sin ejecutar nada.
VERSION_OK=$("$PY" -c 'import sys; print("RENTA_CO_OK" if sys.version_info >= (3, 11) else "")' 2>/dev/null) || VERSION_OK=""
if [ "$VERSION_OK" != "RENTA_CO_OK" ]; then
    echo "✗ '$PY' no es un Python 3.11 o superior utilizable." >&2
    echo "  El motor usa tomllib, que es stdlib desde 3.11." >&2
    echo "  Exporta RENTA_CO_PYTHON con la ruta a un intérprete válido." >&2
    exit 1
fi

# El lanzador hace `cd` a la raíz del repo para poder importar el paquete
# `engine`. Eso cambia el significado de cualquier ruta relativa que venga
# del usuario — incluido el `--expediente ./expediente` por defecto, que
# apuntaría al expediente DEL REPO en vez de al del usuario. Como
# `expediente/` está en .gitignore, ese es un sitio plausible para datos
# reales: se podría liquidar el expediente equivocado en silencio.
#
# Por eso las rutas se resuelven contra el directorio donde se invocó el
# lanzador, ANTES del cd.
ORIGEN=$(pwd)

absolutizar() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  printf '%s/%s' "$ORIGEN" "$1" ;;
    esac
}

SUBCOMANDO=${1:-}
[ $# -gt 0 ] && shift

# Se reconstruyen los argumentos con `set -- "$@" "$arg"`, que preserva
# EXACTAMENTE cada uno: espacios, comillas, saltos de línea y cadenas
# vacías. Una versión anterior los unía con saltos de línea y los volvía a
# partir con IFS: perdía los argumentos vacíos, partía en dos los que
# contenían un salto de línea, y como no desactivaba el globbing, un
# expediente llamado "expediente[2]" se expandía a otro directorio.
set -f                      # sin expansión de comodines
TIENE_EXPEDIENTE=0
ESPERA_RUTA=0
N=$#
I=0
while [ "$I" -lt "$N" ]; do
    arg=$1
    shift
    if [ "$ESPERA_RUTA" = "1" ]; then
        arg=$(absolutizar "$arg")
        ESPERA_RUTA=0
    else
        case "$arg" in
            --expediente|--perfil)
                ESPERA_RUTA=1
                [ "$arg" = "--expediente" ] && TIENE_EXPEDIENTE=1
                ;;
            --expediente=*|--perfil=*)
                # La forma con "=" también lleva ruta. Omitirla dejaba viva
                # justo la resolución contra el repo que este bloque existe
                # para evitar.
                clave=${arg%%=*}
                valor=${arg#*=}
                arg="$clave=$(absolutizar "$valor")"
                [ "$clave" = "--expediente" ] && TIENE_EXPEDIENTE=1
                ;;
            -*)
                : ;;
            *)
                [ "$SUBCOMANDO" = "privacidad" ] && arg=$(absolutizar "$arg")
                ;;
        esac
    fi
    set -- "$@" "$arg"
    I=$((I + 1))
done

# Si el subcomando trabaja sobre un expediente y no se pasó --expediente, se
# inyecta el del directorio DESDE DONDE se invocó. El default de argparse es
# "./expediente" y se resolvería después del cd, apuntando al del repo.
case "$SUBCOMANDO" in
    calcular|importar|verificar)
        [ "$TIENE_EXPEDIENTE" = "0" ] && set -- "$@" --expediente "$ORIGEN/expediente"
        ;;
esac
set +f

cd "$RAIZ"

case "$SUBCOMANDO" in
    privacidad) exec "$PY" "$RAIZ/scripts/escanear_privacidad.py" "$@" ;;
    benchmark)  exec "$PY" -m benchmark.correr "$@" ;;
    "")         exec "$PY" -m engine.cli ;;
    *)          exec "$PY" -m engine.cli "$SUBCOMANDO" "$@" ;;
esac
